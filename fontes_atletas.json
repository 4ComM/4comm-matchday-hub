{
  "_doc": {
    "o_que_e": "Cadastro de FONTES por atleta: onde buscar jogos e desempenho de cada um. Evita busca por nome, que casa homônimos (o 'Fabinho' errado era o ex-Liverpool; o 'Moisés' errado era o Caicedo do Chelsea).",
    "regra_de_fonte": "Profissional -> ogol (id abaixo) ou Sofascore, disponível segundos após o jogo. Base -> súmula oficial da federação (estadual/nacional), usando o nome civil de registro. ScoutHub nunca é fonte primária.",
    "campos": {
      "ogol_id": "id numérico da página do jogador no ogol; a URL é https://www.ogol.com.br/jogador/{ogol_slug}/{ogol_id}/jogos?epoca_id=155 (155 = temporada 2026)",
      "nome_civil": "nome de registro como aparece na súmula da federação — a súmula NÃO usa apelido, e trunca nomes longos — extraído automaticamente da página do ogol quando há ogol_id",
      "federacao": "sigla da federação que publica a súmula dos jogos dele",
      "clube_fonte": "nome do clube exatamente como a federação escreve",
      "categorias": "categorias em que ele pode ser relacionado nessa federação",
      "federacoes": "lista — um atleta de base joga estadual E nacional (ex.: Arthur Diniz no Paulistão e no Brasileirão Sub-17). Marcar só uma federação faz perder metade dos jogos.",
      "clube_cbf": "nome do clube como a CBF escreve, quando difere da federação estadual",
      "nascimento": "data de nascimento (ogol)",
      "altura_cm": "altura em cm (ogol)",
      "peso_kg": "peso em kg (ogol)",
      "pe": "pé preferencial (ogol)",
      "posicao": "posição (ogol)",
      "naturalidade": "cidade/país de nascimento (ogol)",
      "situacao_ogol": "situação do jogador no ogol (em atividade, retirado)"
    },
    "atualizado": "07/08/2026 — IDs confirmados pelo Felipe",
    "regra_categoria": "Sub-N em 2026 exige nascimento >= 2026-N. Categoria errada faz o atleta sumir da varredura — conferir sempre contra a data de nascimento."
  },
